{
  "name": "hardhat-project",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test && node test/client.integration.js",
    "test:contracts": "hardhat test",
    "test:client": "node test/client.integration.js",
    "node": "hardhat node",
    "deploy": "npm run deploy:token && npm run deploy:exchange",
    "deploy:token": "hardhat run --network localhost scripts/deploy_token.js",
    "deploy:exchange": "hardhat run --network localhost scripts/deploy_exchange.js",
    "serve": "python3 -m http.server 8081 --bind 127.0.0.1 --directory web_app"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.4",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.6",
    "@nomicfoundation/hardhat-toolbox": "^2.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.1",
    "@openzeppelin/contracts": "^4.9.3",
    "@typechain/ethers-v5": "^10.1.0",
    "@typechain/hardhat": "^6.1.3",
    "chai": "^4.3.6",
    "ethers": "^5.7.2",
    "hardhat": "^2.18.3",
    "hardhat-gas-reporter": "^1.0.9",
    "solidity-coverage": "^0.8.2",
    "typechain": "^8.1.0"
  },
  "type": "commonjs"
}
